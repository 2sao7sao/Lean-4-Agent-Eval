{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sales numerical analysis envelope v1",
  "description": "Numerical/clarification envelope only; no quality, trace or PPT proof.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "sales.analysis.v1"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "const": "completed"
        },
        "currency": {
          "enum": [
            "CNY",
            "USD"
          ]
        },
        "amount_unit": {
          "const": "minor"
        },
        "monthly_minor": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 2,
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "delta_minor": {
          "type": "integer"
        },
        "change_ratio": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "numerator": {
                  "type": "integer"
                },
                "denominator": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "numerator",
                "denominator"
              ],
              "additionalProperties": false
            }
          ]
        },
        "groups": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "baseline_minor": {
                  "type": "integer",
                  "minimum": 0
                },
                "comparison_minor": {
                  "type": "integer",
                  "minimum": 0
                },
                "delta_minor": {
                  "type": "integer"
                }
              },
              "required": [
                "baseline_minor",
                "comparison_minor",
                "delta_minor"
              ],
              "additionalProperties": false
            }
          }
        },
        "row_count": {
          "type": "integer",
          "minimum": 0
        },
        "included_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "schema_version",
        "input_sha256",
        "status",
        "currency",
        "amount_unit",
        "monthly_minor",
        "delta_minor",
        "change_ratio",
        "groups",
        "row_count",
        "included_count"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "sales.analysis.v1"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "const": "needs_clarification"
        },
        "issues": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "MISSING_COLUMNS",
              "CSV_SHAPE",
              "EMPTY_DATASET",
              "INPUT_LIMIT_EXCEEDED",
              "DUPLICATE_ORDER_ID",
              "MISSING_VALUE",
              "CURRENCY_MISMATCH",
              "INVALID_STATUS",
              "INVALID_DATE",
              "INVALID_AMOUNT",
              "REFUND_EXCEEDS_GROSS"
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "input_sha256",
        "status",
        "issues"
      ],
      "additionalProperties": false
    }
  ]
}
