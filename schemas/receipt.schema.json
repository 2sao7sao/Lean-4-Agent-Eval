{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "contract_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "contract_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "check_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "verifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "verifier_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "ERROR"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "verification_level": {
      "enum": [
        "deterministic",
        "runtime_policy",
        "model_judge",
        "human_review",
        "formal"
      ]
    },
    "proof_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "contract_id",
    "contract_version",
    "contract_sha256",
    "run_id",
    "case_id",
    "check_id",
    "verifier",
    "verifier_version",
    "verdict",
    "evidence_ids",
    "reason",
    "verification_level",
    "proof_ref"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CheckReceipt v0.1",
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_ids": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification_level": {
            "const": "formal"
          },
          "verdict": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "proof_ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  ]
}
