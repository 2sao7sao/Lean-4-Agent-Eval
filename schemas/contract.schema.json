{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "contract_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "status": {
      "enum": [
        "draft",
        "frozen"
      ]
    },
    "approved_by": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source_request": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "media_type": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "path",
          "media_type",
          "constraints"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "media_type": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "path",
          "media_type",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "acceptance": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "mandatory": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "source",
          "acceptance",
          "mandatory"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "evidence_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "producer": {
            "enum": [
              "runner",
              "agent",
              "evaluator"
            ]
          },
          "completeness": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "kind",
          "producer",
          "completeness"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "required": {
            "type": "boolean"
          },
          "method": {
            "enum": [
              "deterministic",
              "runtime_policy",
              "model_judge",
              "human_review",
              "formal"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "verifier": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "verifier_version": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "implementation": {
            "enum": [
              "planned",
              "implemented"
            ]
          },
          "acceptance": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "parameters": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "requirement_ids",
          "required",
          "method",
          "evidence_ids",
          "verifier",
          "verifier_version",
          "implementation",
          "acceptance",
          "parameters"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "decision_policy": {
      "const": "mandatory_all_pass_v1"
    },
    "experiment_plan": {
      "type": "object",
      "properties": {
        "strata": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        },
        "split_policy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "repeat_policy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "budget_policy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "promotion_policy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "strata",
        "split_policy",
        "repeat_policy",
        "budget_policy",
        "promotion_policy"
      ],
      "additionalProperties": false
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiler",
        "session_id",
        "facts",
        "provenance",
        "requirements_confirmation"
      ],
      "properties": {
        "compiler": {
          "const": "sales-to-ppt.rules.v1"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "facts": {
          "type": "object",
          "minProperties": 1
        },
        "provenance": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "turn_id",
              "excerpt"
            ],
            "properties": {
              "turn_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "excerpt": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        "requirements_confirmation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "review_sha256",
                "confirmed_by"
              ],
              "properties": {
                "review_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "confirmed_by": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          ]
        }
      }
    }
  },
  "required": [
    "schema_version",
    "contract_id",
    "version",
    "status",
    "approved_by",
    "open_questions",
    "goal",
    "source_request",
    "assumptions",
    "inputs",
    "deliverables",
    "requirements",
    "evidence_requirements",
    "checks",
    "decision_policy",
    "experiment_plan"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvaluationContract v0.1"
}
